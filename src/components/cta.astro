<div class="ml-embedded" data-form="Trr59J"></div>

<div
  class="bg-yellow-500 p-4 md:px-10 md:py-10 mt-10 mx-auto max-w-2xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    The Bike Bus Pledge
  </h2>
     <div class="text-black mt-4 text-2xl md:text-2xl text-center mx-auto max-w-xs">
      <div style="font-weight: bold; text-decoration: underline;">I promise to...</div>
      <div>1. Wear a helmet</div>
      <div>2. Follow traffic laws</div>
      <div>3. Ride without racing</div>
      <div>4. Ride in a straight line</div>
      <div>5. Look at what’s ahead of me, and listen to what’s around me</div>
    </div>
  </div>
</div>

<div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-3xl font-semibold text-center">
  Coal Route: 1st & 3rd Wednesday of Each Month
<div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-xl font-semibold text-center">
  Meet at a stop or join in as we roll by.<br>
  <div>6:50am - N 2nd & Coal</div>
  <div>6:52am - N 4th & Coal</div>
  <div>6:54am - N 6th & Coal</div>
  <div>6:56am - N 8th & Coal</div>
  <div>6:58am - N 10th & Coal</div>
