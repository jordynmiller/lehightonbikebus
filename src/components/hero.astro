---
import { Picture } from "astro:assets";
import BikeBusColor from "@/assets/BikeBusColor.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---
<!-- MailerLite Universal -->
<script>
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
    .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
    n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
    (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', '1760422');
</script>
<!-- End MailerLite Universal -->

<main
  class="grid lg:grid-cols-2 place-items-center pt-0 pb-8 md:pt-0 md:pb-24">
  <div class="py-2 md:order-1">
    <Picture
      src={BikeBusColor}
      alt="Lehighton Bike Bus"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Ready to ride?
    </h1>
    <p class="text-4xl mt-4 text-yellow-500 max-w-xl">
      Here's how it works:
    </p>
    <p class="text-2xl mt-4 text-black-600 max-w-xl">
      1. Find your school’s route and schedule below.
    </p>
    <p class="text-2xl mt-4 text-black-600 max-w-xl">
      2. To get “on” the bike bus, check the timetable and wait along the route. When you see the bikers heading your way, join the group.
    </p>
    <p class="text-2xl mt-4 text-black-600 max-w-xl">
    Kids ride at their own risk. Parents are encouraged to join for added safety. Parents are responsible for picking up their kids after school.
    </p>
    <p class="text-2xl mt-4 text-yellow-500 max-w-xl">
      Click the other tabs in the menu to learn more!
    </p>
    </div>
  </div>
</main>
