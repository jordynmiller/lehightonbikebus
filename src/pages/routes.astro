---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-T8YDC5BXMF"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-T8YDC5BXMF');
</script>

<Layout title="Blog">
  <Container>

    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-4xl font-semibold text-center">
    Bike Bus beginning September 2025!
    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-0">

    <div
      class="bg-yellow-500 p-4 md:px-10 md:py-10 mt-10 mx-auto max-w-2xl rounded-lg flex flex-col items-center text-center">
      <h2 class="text-white text-4xl md:text-6xl tracking-tight">
        The Bike Bus Pledge
      </h2>
      <div class="text-black mt-4 text-2xl md:text-2xl text-left">
      <div style="font-weight: bold; text-decoration: underline;">I promise to...</div>
        <div>1. Wear a helmet</div>
        <div>2. Follow traffic laws</div>
        <div>3. Ride without racing</div>
        <div>4. Ride in a straight line</div>
        <div>5. Look at what’s ahead of me,</div>
        <div>and listen to what’s around me</div>
      </div>
      <div class="flex mt-5 text-2xl">
        Let's ride!
      </div>
    </div>

    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-3xl font-semibold text-center">
      Coal Route: 1st & 3rd Wednesday of Each Month
    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-xl font-semibold text-center">
      Meet at a stop or join in as we roll by.<br>
      <div>6:40am - N 2nd & Coal</div>
      <div>6:44am - N 4th & Coal</div>
      <div>6:48am - N 6th & Coal</div>
      <div>6:52am - N 8th & Coal</div>
      <div>6:56am - N 10th & Coal</div>
    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-0">
      <iframe src="https://www.google.com/maps/d/embed?mid=11-K6jXoFZFfzirVB2IU2cmbklhfPAQU&ehbc=2E312F&noprof=1" width="100%" height="500" allowfullscreen></iframe>
    </div>
    </div>

    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-3xl font-semibold text-center">
      Iron Route: 2nd & 4th Wednesday of Each Month
    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-xl font-semibold text-center">
      Meet at a stop or join in as we roll by.<br>
      <div>6:35am - N 2nd & Iron</div>
      <div>6:37am - N 4th & Iron</div>
      <div>6:41am - N 6th & Iron</div>
      <div>6:43am - N 7th & Iron</div>
      <div>6:47am - N 9th & Iron</div>
      <div>6:50am - Beaver Run Rd & Mahoning</div>
    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-0">
      <iframe src="https://www.google.com/maps/d/embed?mid=10xmz1WaEXmRjmdilqju-FYSd3qKdADs&ehbc=2E312F&noprof=1" width="100%" height="500" allowfullscreen></iframe>
    </div>
    </div>

    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-5 bg-yellow-0 text-black text-3xl font-semibold text-center">
      Bike Bus Calendar
    <div class="mt-4 mx-auto max-w-4xl rounded-lg p-0" flex justify-center items-center>
      <iframe src="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=America%2FNew_York&mode=AGENDA&src=NWQxZDMyOWJlM2ViMTQ1MjNhYTNlNTUyZmNlYjk1MWRmMzgxODNmNWU2NzdlOTYyOTZhNGU5YzMzMmI5ODUxM0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23f6bf26" style="border-width:0" width="100%" height="600" frameborder="0" scrolling="no"></iframe>
    </div>
    </div>
    
  </Container>
</Layout>
